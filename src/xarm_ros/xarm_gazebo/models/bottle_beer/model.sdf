<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='bottle_beer'>
    <link name='link_2'>

      
      <!-- ВАЖЛИВО: Додаємо фізичні властивості -->
      <inertial>
        <mass>0.5</mass>  <!-- маса в кг (пляшка ~500г) -->
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://bottle_beer/meshes/beer_bottle.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.035 0.415 0.098 1</ambient>
          <diffuse>0.035 0.415 0.098 1</diffuse>
        </material>
        <cast_shadows>1</cast_shadows>
        <transparency>0.4</transparency>
      </visual>
      
      <collision name='collision'>
        <geometry>
          <!-- Краще використовувати просту геометрію для фізики -->
          <cylinder>
            <radius>0.03</radius>    <!-- ~3см радіус -->
            <length>0.2</length>     <!-- 20см висота -->
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.3</restitution_coefficient>
          </bounce>
        </surface>
      </collision>
    </link>
    
    <!-- КЛЮЧОВА ЗМІНА: 0 замість 1 -->
    <static>0</static>  <!-- 0 = динамічна, 1 = статична -->
    
    <!-- Додаткові фізичні параметри -->
    <allow_auto_disable>false</allow_auto_disable>
  </model>
</sdf>
